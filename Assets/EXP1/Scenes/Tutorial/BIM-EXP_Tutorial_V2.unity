      m_Calls: []
  m_text: "Avant toute chose, voyons si les capteurs marchent bien.\nPour cela, vous
    devez voir au dessus du bouton OK, deux ic\xF4nes :\n- une pour le micro qui
    va s'activer si vous parlez\n- une pour le tracking facial\nSi aucune des deux
    n'appara\xEEt, veuillez informer l'organisteur pour relancer\nl'application."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
