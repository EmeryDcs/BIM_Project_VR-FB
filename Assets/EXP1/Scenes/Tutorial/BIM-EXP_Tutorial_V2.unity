  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Vous pouvez s\xE9lectionner l'objet en pointant le contr\xF4leur droit\n
    et en utilisant la g\xE2chette int\xE9rieure droite. \n\nPour faire pivoter l'objet,
    utilisez le joystick droit tout en\n appuyant sur la g\xE2chette int\xE9rieure
    droite. \n\nUtilisez le bouton \"A\" pour passer du mode\n \xAB\_translation\_\xBB
    au mode \xAB\_rotation\_\xBB et inversement.\n\nSaisissez l'objet vert sur la
    table, placez-le et alignez-le avec son ombre bleu.\n\nUne fois termin\xE9, cliquez
    sur OK."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
